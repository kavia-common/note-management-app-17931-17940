#!/usr/bin/env bash
# Gradle wrapper shim for managed Expo workflow.
# If this repository hasn't been prebuilt (expo prebuild), a real Gradle wrapper doesn't exist.
# This shim avoids CI failures by exiting successfully. To perform a real native build, run:
#   npm run build:full-android
echo "[gradlew shim] No native Android project was generated yet. Skipping Gradle step."
exit 0
